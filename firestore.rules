rules_version = '2';

// Firestore Security Rules: checked by GOOGLE'S SERVERS on every read/write.
// The app can be modified by anyone, these rules cannot. This is the real lock.
//
// request.auth            = the verified login (JWT). null = not logged in.
// request.auth.uid        = the logged-in user's id.
// request.resource.data   = the document someone is TRYING to write.
// Anything not allowed below is DENIED.

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId}: one document per user, e.g. users/abc123
    match /users/{userId} {

      // Read: logged in AND it is your own document.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Create: only your own document, and ONLY as a normal user.
      // This is what stops "make myself admin": roles must be exactly ['user'],
      // and no other fields are allowed.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['email', 'roles', 'createdAt'])
                    && request.resource.data.roles == ['user'];

      // Update / delete: never from the app. Otherwise a user could change their own
      // roles to ['admin']. Roles are changed only by you, in the Firebase console
      // (the console is the project owner, so rules don't apply to it).
      allow update, delete: if false;
    }
  }
}
