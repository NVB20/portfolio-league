# Copy to .env for local development (npx expo start --web). Not needed for `docker compose up`, which has these
# values in docker-compose.yml.
#
# Everything here is built into the app and visible to anyone who opens it, so it must never hold a secret.
# The Firebase web config is public by design: it names the project and grants nothing; the API checks every permission.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDmJh7ERkNxpI08JhXdMq8Ie4iSE6uGRDg
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=portfolio-league.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=portfolio-league
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=portfolio-league.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=595027950497
EXPO_PUBLIC_FIREBASE_APP_ID=1:595027950497:web:db22077a9b51a59f3ee9e0

# Our API (api/ folder). Local: http://localhost:3000. Production: the deployed API URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
