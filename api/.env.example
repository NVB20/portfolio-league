# Copy to api/.env for local development. In production, set these as environment variables on the container.

# Local Docker Postgres (docker compose up -d). In production: the production Postgres URL
DATABASE_URL=postgres://hof:hof_dev@localhost:5432/portfolio
# Used by `npm test` (wiped by the tests)
TEST_DATABASE_URL=postgres://hof:hof_dev@localhost:5432/portfolio_test

# The Firebase project whose ID tokens the API accepts (same as EXPO_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=portfolio-league

# Comma-separated web origins allowed to call the API (Expo web dev server runs on 8081)
CORS_ORIGINS=http://localhost:8081

PORT=3000

# The per-minute ticker runs the opens and closes a running clock passes (D-030). Uncomment to turn it off,
# e.g. for a local API on a copy of the database; world events then run only on admin clock moves.
# TICKER=off
